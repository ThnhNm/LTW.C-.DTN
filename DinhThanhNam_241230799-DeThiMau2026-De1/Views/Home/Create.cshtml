@model DinhThanhNam_241230799_DeThiMau2026_De1.Models.TaiSan

@{
    ViewData["Title"] = "Create";
    Layout = "DinhThanhNam_Layout";
}

<div class="section-head">
    <h3>Thêm tài sản mới</h3>
</div>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="MaLoai" class="control-label">Loại tài sản</label>
                <select asp-for="MaLoai" asp-items="ViewBag.DsLoai" class="form-control"></select>
                <span asp-validation-for="MaLoai" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TenTs" class="control-label">Tên tài sản</label>
                <input asp-for="TenTs" class="form-control" />
                <span asp-validation-for="TenTs" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NguyenGia" class="control-label">Nguyên giá (triệu)</label>
                <input asp-for="NguyenGia" class="form-control" />
                <span asp-validation-for="NguyenGia" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Anh" class="control-label">Tên file ảnh</label>
                <input asp-for="Anh" class="form-control" />
                <span asp-validation-for="Anh" class="text-danger"></span>
            </div>

   
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-buy" />
            </div>
        </form>
    </div>
</div>
