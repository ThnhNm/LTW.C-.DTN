@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Dashboard</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active"></li>
    </ol>
    <div class="card mb-4">
        <div class="card-body">
            <a asp-controller="Student" asp-action="Index" class="btn btn-primary">Student</a>
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <a asp-controller="Learner" asp-action="Index" class="btn btn-primary">Learner</a>
        </div>
    </div>
</div>
