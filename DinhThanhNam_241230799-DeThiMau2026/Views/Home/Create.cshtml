@model Sach
@{
    ViewData["Title"] = "Home Page";
    Layout = "DinhThanhNam_Layout";
}

<div class="section-head">
    <h3>ĐINH THÀNH NAM - THÊM SÁCH MỚI</h3>
</div>

<div>
    <form asp-action="Create" method="post">
        <div> 
            <label>MaTl</label>
            <select asp-for="MaTl" asp-items="ViewBag.DsTheLoai"></select>
        </div>
        <div>
            <label>TenSach</label>
            <input asp-for="TenSach" class="form-control" type="text" />
            <span asp-validation-for="TenSach" class="text-danger"></span>
        </div>
        <div>
            <label>Gia</label>
            <input asp-for="Gia" type="text" class="form-control" />
            <span asp-validation-for="Gia" class="text-danger"></span>
        </div>
        <div>
            <label>Anh</label>
            <input asp-for="Anh" />
            <span asp-validation-for="Anh" class="text-danger"></span>
        </div>
        <button type="submit" class="btn-buy">Create</button>
    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}